{
  "name": "root",
  "private": true,
  "type": "module",
  "workspaces": [
    "docs",
    "flow-connect",
    "dev"
  ],
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=11.12.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bhagatsaurabh/flow-connect.git"
  },
  "author": "Saurabh Bhagat",
  "license": "MIT",
  "scripts": {
    "build": "npm run build -w flow-connect && npm run build:browser",
    "build:watch": "npm run build:watch -w flow-connect",
    "build:browser": "npm run build:browser -w flow-connect",
    "dev": "npm run build && concurrently \"npm run build:browser:watch -w flow-connect\" \"npm run dev -w dev\"",
    "docs:dev": "npm run build && npm run docs:dev:watch",
    "docs:dev:watch": "concurrently \"npm run build:watch\" \"vuepress dev docs\"",
    "docs:build": "npm run build && vuepress build docs --clean-temp --clean-cache"
  },
  "keywords": [
    "node editor",
    "node-based editor",
    "flow-connect",
    "HTML5 node editor",
    "node-editor framework",
    "flow connect",
    "canvas library",
    "visual programming",
    "visual programming ui library",
    "node ui library"
  ],
  "devDependencies": {
    "@types/markdown-it-attrs": "^4.1.3",
    "@vuepress/bundler-vite": "^2.0.0-rc.30",
    "@vuepress/plugin-markdown-tab": "^2.0.0-rc.130",
    "@vuepress/plugin-medium-zoom": "^2.0.0-rc.130",
    "@vuepress/plugin-register-components": "^2.0.0-rc.130",
    "@vuepress/plugin-search": "^2.0.0-rc.130",
    "@vuepress/theme-default": "^2.0.0-rc.130",
    "concurrently": "^10.0.4",
    "markdown-it-attrs": "^4.3.1",
    "sass-embedded": "^1.100.0",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^3.11.11",
    "vuepress": "^2.0.0-rc.30"
  }
}
